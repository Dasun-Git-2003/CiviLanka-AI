# =============================================================================
# CiviLanka Master .gitignore
# Comprehensive protection for:
# - ASP.NET Core backend (CiviLanka.API)
# - Node.js Express operations backend (backend/)
# - React / Vite Web platforms (CiviLanka.Web, frontend_director_dashboard/)
# - Flutter Mobile applications (CiviLanka.App, mobile_fieldworker_flutter/)
# - Python Agentic AI (CiviLanka.Agent)
# - Database credentials, environment secrets, and runtime artifacts
# =============================================================================

# ── Environment & Secret Configurations ───────────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.env.local
**/.env
**/.env.*
**/*.env
!**/.env.example
!.env.example
!**/.env.template
!.env.template
!**/.env.sample
!.env.sample

# Secret & credential storage
secrets.json
connectionstrings.json
*.secret
*.secrets
*.token
*credentials*.json
*secret*.json
*token*.json
service-account*.json
*service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
client_secrets*.json
oauth-credentials*.json

# ── Certificates, Private Keys & Keystores ───────────────────────────────────
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.der
*.cer
*.asc
*.keystore
*.jks
*.pub
id_rsa*
id_ed25519*

# ── Backup & Temporary Files ──────────────────────────────────────────────────
*.bak
*.backup
*.old
*.swp
*.swo
*~

# ── ASP.NET Core Configuration & Database Credentials ────────────────────────
appsettings.json
appsettings.*.json
appsettings.local.json
appsettings*.bak
!appsettings.example.json

