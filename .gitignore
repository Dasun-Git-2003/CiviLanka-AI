# =============================================================================
# CivitaGuard AI — Master .gitignore
# Strictly ignores all secret files, API keys, credentials, and build artifacts
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
.env.local
*.env
*.env.local
secrets.json
connectionstrings.json

# ── ASP.NET Core Configuration Secrets ───────────────────────────────────────
appsettings.json
appsettings.*.json
!appsettings.example.json

# ── Cloud, Google & Service Account Keys ─────────────────────────────────────
*service-account*.json
google-services.json
GoogleService-Info.plist
*.credentials.json
client_secrets.json

# ── Certificates, Private Keys & Keystores ───────────────────────────────────
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
*.pub
id_rsa*
id_ed25519*

# ── IDE & Local Workspace Settings ───────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# ── .NET / C# Build Artifacts ────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.tmp
*.log

# ── Node.js / React Web Artifacts ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Flutter / Mobile Build Artifacts ─────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
flutter_*.png

# ── OS Generated Files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
