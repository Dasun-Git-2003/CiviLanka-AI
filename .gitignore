# =============================================================================
# CiviLanka Master .gitignore
# Comprehensive protection for .NET backend, React Web, Flutter Mobile,
# Python Agentic AI (CiviLanka.Agent), database credentials, and secrets.
# =============================================================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
.env.local
*.env
*.env.local
secrets.json
connectionstrings.json
*.secret
*.secrets
*.token
*.bak
*.backup
*.old

# ── ASP.NET Core Configuration & Database Credentials ────────────────────────
appsettings.json
appsettings.*.json
appsettings.local.json
appsettings*.bak
!appsettings.example.json

# ── Cloud, Google & Service Account Keys ─────────────────────────────────────
*service-account*.json
google-services.json
GoogleService-Info.plist
*.credentials.json
client_secrets.json

# ── Certificates, Private Keys & Keystores ───────────────────────────────────
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
*.pub
id_rsa*
id_ed25519*

